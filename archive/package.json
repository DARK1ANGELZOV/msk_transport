{
  "name": "ekipazh-400",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ЭКИПАЖ 400 — тренажёр поездной бригады ВСМ",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning tools/seed.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate-scenario.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node e2e/flow.mjs",
    "test:trip": "node e2e/trip.mjs",
    "test:speech": "node e2e/speech.mjs",
    "bench:intent": "node tools/intent-bench.mjs",
    "test:shots": "node e2e/shots.mjs",
    "check": "npm run validate && npm test && npm run bench:intent && npm run typecheck"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
