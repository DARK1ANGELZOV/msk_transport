# ЭКИПАЖ 400 — переменные окружения.
# Скопируйте в .env и правьте под свою установку.

# Порт сервера. Он же отдаёт статику клиента из dist/.
PORT=8787

# Каталог с базой. Внутри лежит ekipazh.sqlite — обычный файл SQLite,
# который переносится копированием и открывается любым клиентом.
DATA_DIR=data

# Полный путь к файлу базы, если каталога недостаточно.
# DB_FILE=/data/ekipazh.sqlite

# Origin, которому разрешены запросы с куками. Пусто — кросс-доменные
# запросы не разрешаются вовсе (правильно, когда фронт и API на одном домене).
ALLOWED_ORIGIN=

# Пароль демонстрационных учёток, которые заводит `npm run seed`.
# Пустое значение означает krechet-2028. Для установки у заказчика
# демо-данные не заливаются вообще: учётки заводятся заново.
SEED_PASSWORD=

# Адрес API для vite в разработке. По умолчанию http://localhost:8787.
# API_ORIGIN=http://localhost:8787
