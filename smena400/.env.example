# ───────────────────────────────────────────────────────────────────────────
# «Смена 400» запускается без единой переменной окружения.
# Всё ниже — необязательно.
# ───────────────────────────────────────────────────────────────────────────

# Порт API и раздачи собранного клиента.
PORT=5400

# Файл базы. По умолчанию data/smena400.db рядом с проектом.
DB_FILE=data/smena400.db

# ─── AI-слой (полностью опционален) ───────────────────────────────────────
# Без ключа продукт работает в детерминированном режиме: свободные реплики
# разбирает собственный анализатор, пассажир говорит заранее написанными
# фразами. Сценарии, шкалы и переходы от AI не зависят вообще.
#
# С ключом добавляется: перефразирование реплик пассажира и запасной разбор
# свободного ответа, когда собственный анализатор не уверен.
# Ключ читает только сервер. В браузер он не попадает никогда.

# openai | compatible  (любой сервис с OpenAI-совместимым /chat/completions)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Для собственного или альтернативного шлюза:
AI_BASE_URL=https://api.openai.com/v1
