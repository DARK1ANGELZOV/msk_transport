{
  "name": "smena-400",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "СМЕНА 400 — интерактивный тренажёр принятия решений для проводников ВСМ",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "db:seed": "node --disable-warning=ExperimentalWarning tools/seed.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate.mjs",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/api.e2e.mjs",
    "check": "npm run validate && npm test && npm run typecheck"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
